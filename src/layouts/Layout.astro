---
import '../styles/global.css';

// Defines the props this layout expects
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a href="/">☕ Coffee Notes from Underground</a>
    </header>
    <main>
      <!-- Renders the page content passed into this layout -->
      <slot />
    </main>
  </body>
</html>

<style>
  header {
    padding: 2rem 0 1rem;
  }
  header a {
    text-decoration: none;
    font-weight: bold;
    font-size: 1.1rem;
    color: var(--coffee-dark);
  }
</style>
